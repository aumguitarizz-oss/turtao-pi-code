[Unit]
Description=Turtao Surveillance Robot
After=network.target bluetooth.target sound.target
Wants=bluetooth.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/turtao-pi
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/sleep 35
ExecStart=/home/pi/turtao-pi/venv/bin/python3 main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
